<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0a">

    <!-- Backdrop -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <ImageView
            android:id="@+id/backdropImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#1a1a1a" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_overlay" />

        <!-- Back button -->
        <TextView
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:gravity="center"
            android:text="&#8592;"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:background="#44000000" />

        <!-- Info over backdrop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:padding="12dp">

            <ImageView
                android:id="@+id/posterImage"
                android:layout_width="80dp"
                android:layout_height="115dp"
                android:scaleType="centerCrop"
                android:background="#222222" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/episodeDramaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="4" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/infoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E50914"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/infoEpisodes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#aaaaaa"
                        android:textSize="11sp"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/infoCountry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#aaaaaa"
                        android:textSize="11sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#cccccc"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="4" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Episodes label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Episodes"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <ProgressBar
        android:id="@+id/episodeLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="#E50914"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episodeRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:id="@+id/episodeDebugScroll"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#050505">
        <TextView
            android:id="@+id/episodeDebugText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00ff88"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:padding="6dp" />
    </ScrollView>

    <WebView
        android:id="@+id/episodeWebView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

</LinearLayout>
